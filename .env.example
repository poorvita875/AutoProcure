# ── Required ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A – single URL (preferred)
DATABASE_URL=postgresql://postgres:password@localhost:5432/autoprocure

# Option B – individual vars (used when DATABASE_URL is absent)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=autoprocure
# PG_USER=postgres
# PG_PASSWORD=password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGINS=*
